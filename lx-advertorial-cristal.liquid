<!-- ══════════════════════════════════════════════════════
     JAVASCRIPT
     ══════════════════════════════════════════════════════ -->
<script>
(function() {
  // COUNTDOWN
  var end = new Date();
  end.setHours(end.getHours() + 2, end.getMinutes() + 14, end.getSeconds() + 33);
  var stored = sessionStorage.getItem('lxadv_cd');
  if (stored) {
    end = new Date(parseInt(stored));
  } else {
    sessionStorage.setItem('lxadv_cd', end.getTime().toString());
  }
  function tick() {
    var diff = Math.max(0, end - new Date());
    var h = Math.floor(diff / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    var pad = function(n){ return n < 10 ? '0'+n : ''+n; };
    var eh = document.getElementById('lxadv-h');
    var em = document.getElementById('lxadv-m');
    var es = document.getElementById('lxadv-s');
    if (eh) eh.textContent = pad(h);
    if (em) em.textContent = pad(m);
    if (es) es.textContent = pad(s);
  }
  tick();
  setInterval(tick, 1000);
})();

// FAQ
window.lxadvFaq = function(btn) {
  var item = btn.closest('.faq-item');
  var open = item.classList.contains('open');
  var all = document.querySelectorAll('.lxadv .faq-item');
  for (var i = 0; i < all.length; i++) all[i].classList.remove('open');
  if (!open) item.classList.add('open');
};
</script>

